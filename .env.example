# Gemini API Key (Get a free key in 30 seconds at https://aistudio.google.com/)
GEMINI_API_KEY=

# Optional Gemini Model (Defaults to gemini-2.0-flash, or use gemini-2.5-flash)
GEMINI_MODEL=gemini-2.0-flash

# Optional Google Cloud Text-to-Speech API Key (Chirp 3 HD & Neural2)
# If empty, Sahara automatically uses GEMINI_API_KEY or falls back seamlessly to Web Speech API
GOOGLE_CLOUD_TTS_API_KEY=
